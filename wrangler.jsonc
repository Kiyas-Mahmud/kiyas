{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kiyas",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "kiyas.me", "custom_domain": true },
    { "pattern": "www.kiyas.me", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*", "/media/*", "/cv", "/cv.pdf", "/pdf/kiyasmahmud.pdf"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kiyas-db",
      "database_id": "c33283f9-ee5c-464b-bfc6-4cb52bca3f35",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "kiyas-media"
    }
  ],
  "observability": { "enabled": true }
}
